root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,props,csproj,slnx}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_style_qualification_for_field = false:warning
dotnet_sort_system_directives_first = true

# Remove unnecessary usings (IDE0005) needs GenerateDocumentationFile to run in build; keep it in format only.
dotnet_diagnostic.IDE0005.severity = suggestion

# Generated EF migrations.
[**/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none

[tests/**.cs]
# Test method names use underscores for readability.
dotnet_diagnostic.CA1707.severity = none
# xUnit tests do not need ConfigureAwait.
dotnet_diagnostic.CA2007.severity = none
# Inline expected-value arrays in assertions are clearer than static fields.
dotnet_diagnostic.CA1861.severity = none
